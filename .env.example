# ---- BACKEND (Render environment variables / local backend/.env) - placeholders only ----
APP_ENV=production                       # use "development" locally
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
FRONTEND_ORIGIN=https://your-app.vercel.app    # exact origin(s), comma separated, no trailing slash, never *
TOKEN_MINUTES=60

# Oracle Autonomous Database (application user, NOT ADMIN)
ORACLE_USER=PETROPULSE_APP
ORACLE_PASSWORD=replace-with-the-app-user-password
ORACLE_DSN=petropulse_high               # a TNS alias from the wallet's tnsnames.ora, or a full connect string
# wallet (mTLS) - use ONE of the two:
ORACLE_WALLET_DIR=/etc/secrets           # Render: secret files tnsnames.ora + ewallet.pem live here. Windows: e.g. C:\petropulse\wallet
# ORACLE_WALLET_B64=                     # base64 of the wallet .zip (fallback; see DEPLOYMENT_GUIDE.md)
ORACLE_WALLET_PASSWORD=replace-with-the-wallet-password   # the password chosen when downloading the wallet
ORACLE_POOL_MAX=4

# Only for the seed script
# DEMO_PASSWORD=choose-a-demo-password
